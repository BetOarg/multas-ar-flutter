<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Directorio de caché — escritos temporales para compartir -->
    <cache-path
        name="escritos_cache"
        path="escritos/" />

    <!-- Almacenamiento externo público — documentos exportados -->
    <external-path
        name="documentos_externos"
        path="Documents/" />

    <!-- Almacenamiento interno de la app — base de datos y exports -->
    <files-path
        name="archivos_app"
        path="." />

    <!-- Cache raíz — imágenes temporales de OCR -->
    <cache-path
        name="ocr_tmp"
        path="." />

</paths>
