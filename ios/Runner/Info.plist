<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ── Identidad ──────────────────────────────────────────── -->
  <key>CFBundleName</key>
  <string>Multas Argentina</string>
  <key>CFBundleDisplayName</key>
  <string>Multas AR</string>
  <key>CFBundleIdentifier</key>
  <string>com.betOarg.multasAr</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>

  <!-- ── Permisos ───────────────────────────────────────────── -->

  <!-- Cámara — OCR de actas -->
  <key>NSCameraUsageDescription</key>
  <string>Multas Argentina necesita acceso a la cámara para fotografiar actas de infracción y analizarlas automáticamente.</string>

  <!-- Galería de fotos — seleccionar imagen de acta -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Multas Argentina necesita acceso a la galería para seleccionar fotografías de actas de infracción.</string>

  <!-- Guardar en galería — exportar escritos como imagen -->
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>Multas Argentina puede guardar documentos en tu galería para compartirlos fácilmente.</string>

  <!-- Micrófono — no se usa, pero requerido por algunas dependencias -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Multas Argentina no utiliza el micrófono.</string>

  <!-- ── Notificaciones locales ──────────────────────────────── -->
  <key>UIBackgroundModes</key>
  <array>
    <string>fetch</string>
    <string>remote-notification</string>
  </array>

  <!-- ── Configuración de la app ────────────────────────────── -->
  <key>UIApplicationSupportsIndirectInputEvents</key>
  <true/>

  <key>UIRequiresFullScreen</key>
  <false/>

  <!-- Orientación soportada — portrait únicamente -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
  </array>

  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- Launch screen -->
  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>

  <key>UIMainStoryboardFile</key>
  <string>Main</string>

  <!-- ── Seguridad de red ────────────────────────────────────── -->
  <!-- Permitir HTTPS a api.anthropic.com únicamente -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>api.anthropic.com</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <false/>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
    </dict>
  </dict>

  <!-- ── Flutter ────────────────────────────────────────────── -->
  <key>CADisableMinimumFrameDurationOnPhone</key>
  <true/>
  <key>FlutterDeepLinkingEnabled</key>
  <true/>

</dict>
</plist>
